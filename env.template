# Copy to .env and fill in. Never commit .env (it is git-ignored).
STEEL_API_KEY=
ANTHROPIC_API_KEY=
# Optional: bring-your-own proxy if Steel managed proxies are not unlocked
PERISCOPE_PROXY_URL=
# Notifier targets (optional)
PERISCOPE_WEBHOOK_URL=
# Runtime data directory (must be outside OneDrive)
PERISCOPE_DATA_DIR=./data
# Browsers at once. Must match the Steel plan: 10 on Launch, 100 on Scale.
PERISCOPE_MAX_CONCURRENT=10
# Whole-site runs: browsers used (default: all) and pages per browser (default 5)
PERISCOPE_MAP_BROWSERS=
PERISCOPE_MAP_PAGES_PER_BROWSER=3
